<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Modern clean theme - no action bar, edge-to-edge friendly -->
    <style name="Theme.AntiBloater" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary: modern blue-purple -->
        <item name="colorPrimary">#5B5FE6</item>
        <item name="colorPrimaryVariant">#4347C9</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <!-- Secondary: fresh teal accent -->
        <item name="colorSecondary">#26C6DA</item>
        <item name="colorSecondaryVariant">#0097A7</item>
        <item name="colorOnSecondary">@android:color/black</item>
        <!-- Surface -->
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorSurfaceVariant">#F5F5F5</item>
        <item name="colorOnSurface">#1C1B1F</item>
        <!-- Status bar: light for edge-to-edge -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <!-- Outline color for cards -->
        <item name="colorOutline">#E0E0E0</item>
    </style>
</resources>
